PORT=3000

API_KEY=change-me
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
SESSION_SECRET=change-me
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-mysql-database

MSSQL_HOST=your-mssql-host
MSSQL_PORT=1433
MSSQL_AUTH_TYPE=sql
MSSQL_USER=your-mssql-user
MSSQL_PASSWORD=your-mssql-password
MSSQL_DATABASE=your-mssql-database
# Required only when MSSQL_AUTH_TYPE=ntlm
MSSQL_DOMAIN=your-windows-domain
GP_ANALYSIS_TABLE=dbo.gp_analysis_header_by_category_daily
